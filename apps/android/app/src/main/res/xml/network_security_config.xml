<?xml version="1.0" encoding="utf-8"?>
<!-- 서버 주소는 사용자가 정한다 — 집 안의 http://192.168.x.x:7701 도 열 수 있어야 한다.
     단 http 화면에서는 브라우저가 마이크를 막으므로(보안 컨텍스트가 아니다) 음성은 https 서버에서만 된다. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
