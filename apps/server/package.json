{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test:subtask-gate-contract": "node --test test/subtask-gate-contract.test.mjs",
    "pretest:qa:pg": "node test/run-suite.mjs --suite pretest-qa-pg",
    "pretest": "npm run build && node test/run-suite.mjs --suite pretest",
    "posttest": "node test/run-suite.mjs --suite posttest",
    "pretest:qa": "node test/run-suite.mjs --suite pretest-qa",
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "mcp": "tsx src/mcp-server.ts",
    "mcp:http": "MCP_TRANSPORT=http tsx src/mcp-server.ts",
    "mcp:build": "nest build && node dist/mcp-server.js",
    "test:postgres-schema": "node --test --test-force-exit test/postgres-schema-search-path.test.mjs",
    "test:mention-audit": "npm run build && node test/run-suite.mjs test/qa-flows/mention-audit-retry.test.mjs",
    "migration:generate": "tsx ../../node_modules/typeorm/cli.js migration:generate -d src/db.ts",
    "migration:create": "tsx ../../node_modules/typeorm/cli.js migration:create",
    "migration:run": "tsx ../../node_modules/typeorm/cli.js migration:run -d src/db.ts",
    "migration:revert": "tsx ../../node_modules/typeorm/cli.js migration:revert -d src/db.ts",
    "test:catalog-scope": "node --test test/agent-manager-instance-supersede.test.mjs test/catalog-scope.test.mjs test/catalog-scope-promotion.test.mjs",
    "test:auto-notice": "node --test test/comment-tools-auto-notice.test.mjs",
    "test": "node test/run-suite.mjs --suite test",
    "test:qa": "node test/run-suite.mjs --suite test-qa",
    "test:qa:fast": "node test/run-suite.mjs --suite test-qa-fast",
    "test:qa:pg": "node test/run-suite.mjs --suite test-qa-pg"
  },
  "dependencies": {
    "@ast-grep/napi": "^0.45.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/serve-static": "^5.0.0",
    "@nestjs/swagger": "^11.3.0",
    "@nestjs/typeorm": "^11.0.0",
    "@node-rs/xxhash": "^1.7.7",
    "bcryptjs": "^3.0.3",
    "compression": "^1.7.5",
    "helmet": "^8.3.0",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "sql.js": "^1.12.0",
    "tree-sitter-wasms": "^0.1.13",
    "typeorm": "^0.3.31",
    "undici": "^7.29.0",
    "web-tree-sitter": "^0.25.10",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/express": "^5.0.0",
    "@types/pg": "^8.20.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
