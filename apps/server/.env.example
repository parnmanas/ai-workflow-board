# ──────────────────────────────────────────
# AI Workflow Board - Server Configuration
# ──────────────────────────────────────────
# From the repository root: cp apps/server/.env.example apps/server/.env
# Backend npm scripts run in apps/server and load that .env via dotenv/config.
# Compose uses the root .env + docker-compose.env.example instead.
# .env is gitignored and never committed.

# ── Server ────────────────────────────────
PORT=7701
NODE_ENV=development

# Optional cross-origin browser access. Unset: reflect origins in development,
# reject cross-origin requests in production. Same-origin UI/API needs no value.
# CORS_ORIGIN=https://awb.example.com

# ── Database ──────────────────────────────
# sqlite (sql.js, default for local dev) | postgres (deployment)
# A mysql configuration branch remains in db.ts, but mysql2 is not bundled.
DB_TYPE=sqlite

# Postgres / MySQL settings (ignored when DB_TYPE=sqlite)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_workflow
DB_USER=postgres
DB_PASS=

# Optional absolute file paths for isolated local/standalone MCP processes.
# Relative paths resolve under the repository's database/ directory.
# Never run two sql.js writer processes against the same files.
# SQLJS_DB_PATH=/absolute/path/awb-dev/data.db
# SQLJS_ONTOLOGY_DB_PATH=/absolute/path/awb-dev/ontology.db

# Server files / credential encryption. Defaults to repository database/.
# Preserve .encryption_key together with the database, or manage a stable secret.
# AWB_DATA_DIR=/absolute/path/awb-data
# ENCRYPTION_KEY=your-stable-random-secret

# ── MCP Authentication ────────────────────
# Comma-separated API keys for MCP endpoint.
# Format: agentName:key,agentName2:key2  (or just key,key2)
# Prefer keys created under Settings > API Keys, or Runtime Host pairing.
# Empty does NOT enable unauthenticated MCP. For a local bypass explicitly set
# MCP_DEV_MODE=true; it works only outside production and with no active DB/env keys.
MCP_API_KEYS=
# MCP_DEV_MODE=true

# ── Agent API ─────────────────────────────
# Legacy shared secret. Normal Runtime Hosts use their pairing-issued key.
# Empty does NOT enable unauthenticated agent API access. A local bypass requires
# AGENT_DEV_MODE=true outside production and with AGENT_API_KEY absent.
AGENT_API_KEY=
# AGENT_DEV_MODE=true
