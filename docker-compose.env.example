# docker-compose 용 환경변수 (.env로 복사해서 사용)
DB_NAME=ai_workflow
DB_USER=postgres
DB_PASS=your-secure-password-here

# Trademark connector OAuth callback origin. Use the externally reachable HTTPS
# origin only (no path), then register /api/business-integrations/oauth/callback
# under that origin in each provider application. Required for OAuth login.
# AWB_PUBLIC_URL=https://awb.example.com

# Optional environment API keys must name their owning account. Prefer
# Runtime Host pairing / UI-managed keys, which persist ownership in the DB.
# AGENT_API_KEY=replace-with-an-agent-key
# AGENT_ACCOUNT_ID=existing-account-uuid
# MCP_API_KEYS=agentName:replace-with-an-mcp-key
# MCP_ACCOUNT_ID=existing-account-uuid

# Optional: stable secret used to derive the AES-256-GCM key that encrypts
# Credential rows (provider tokens, API keys). If unset the server
# auto-generates a key file under the awbdata volume (compose handles this).
# Set this only if you want to manage the key yourself — e.g. rotate it or
# share it across replicas. Losing the configured value (or the awbdata
# volume) makes every stored credential undecryptable.
# Generate with: openssl rand -hex 32
# ENCRYPTION_KEY=replace-with-a-long-random-secret

# One-time migration 95: confirmed active user UUID that owns existing work.
# Required when upgrading an installation with data; leave unset on fresh installs.
# AWB_LEGACY_OWNER_USER_ID=
