# Dependencies
node_modules/
# ...also as a symlink (worktrees symlink node_modules → main checkout); the
# trailing-slash pattern above only matches a real directory, so a bare
# `node_modules` symlink would otherwise be stage-able (a past accident).
node_modules
apps/*/node_modules

# Build output
dist/

# Database
*.db
.encryption_key

# Environment
.env
.env.local
.env.*.local
!.env.example

# Logs
*.log

# Source maps
*.js.map
*.d.ts.map

# Vite
.vite/

# TurboRepo
.turbo/

# Local git worktrees used for isolated feature development
.worktrees/

# OS
.DS_Store
Thumbs.db

# graphify output (run from repo root, sometimes spills here)
graphify-out/

