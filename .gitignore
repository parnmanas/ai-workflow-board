# Dependencies
node_modules/
# ...also as a symlink (worktrees symlink node_modules → main checkout); the
# trailing-slash pattern above only matches a real directory, so a bare
# `node_modules` symlink would otherwise be stage-able (a past accident).
node_modules
apps/*/node_modules

# Build output
dist/

# Database
*.db
.encryption_key

# Environment
.env
.env.local
.env.*.local
!.env.example

# Logs
*.log

# Source maps
*.js.map
*.d.ts.map

# Vite
.vite/

# TurboRepo
.turbo/

# Local git worktrees used for isolated feature development
.worktrees/

# OS
.DS_Store
Thumbs.db

# graphify output (run from repo root, sometimes spills here)
graphify-out/

# 기타 AI CLI 세션 산출물(의도적으로 추적하지 않으며 CLAUDE.md와 별도 관리)
# AGENTS.md는 CLAUDE.md에서 생성하며 의도적으로 버전 관리합니다.

# Playwright e2e 산출물(스크린샷·trace) — 커밋 대상 아님
apps/client/test-results/
apps/client/playwright-report/

# 로컬 MCP 설정 (API 키 포함 — 커밋 금지)
.mcp.json

# Voice-activity-detection runtime, copied from node_modules at build time (apps/client/scripts/copy-vad-assets.mjs).
apps/client/public/vad/

# Capacitor Android (apps/client/android) — 스캐폴딩·네이티브 코드는 추적하고,
# 빌드 산출물과 `npx cap sync` 재생성물(assets/)은 제외한다.
apps/client/android/.gradle/
apps/client/android/app/build/
apps/client/android/app/src/main/assets/
apps/client/android/local.properties
*.apk
*.aab
